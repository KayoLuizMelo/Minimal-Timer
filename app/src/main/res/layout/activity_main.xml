<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Esse é o contêiner (o espaço) onde vamos colocar o Fragment do Timer depois -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- MÓDULO 7: Exibição de Quote consumido via JSON/HTTP -->
    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Carregando frase do dia..."
        android:textAlignment="center"
        android:textStyle="italic"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <!-- Botão simples para abrir as configurações -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙ Configurações"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF" />

</LinearLayout>