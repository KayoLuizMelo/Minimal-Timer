<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvDadosRecebidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aguardando dados..."
            android:layout_marginBottom="24dp" />

        <!-- SharedPreferences Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferências"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDefaultTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempo padrão (minutos)"
            android:inputType="number"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSavePrefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar Tempo Padrão"
            android:layout_marginBottom="24dp"/>

        <!-- History Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Histórico de Sessões (SQLite)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualizar Histórico"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvHistoryDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O histórico de sessões finalizadas aparecerá aqui."
            android:padding="12dp"
            android:background="#f0f0f0" />

    </LinearLayout>
</ScrollView>